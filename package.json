{
  "name": "qoolejs",
  "version": "0.1.0",
  "description": "Quake2-style level editor",
  "source": "src/index.pug",
  "scripts": {
    "start": "parcel",
    "build": "parcel build --public-url /qoolejs/",
    "lint": "biome lint ./src && eslint src",
    "lint:fix": "biome lint --write ./src && eslint src --fix",
    "format": "biome format --write ./src",
    "check": "biome check ./src"
  },
  "author": "Alex Milanov",
  "license": "ISC",
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "font-awesome": "^4.7.0",
    "iblokz-data": "^1.0.2",
    "iblokz-snabbdom-helpers": "^1.0.0",
    "lodash": "^4.13.1",
    "rx": "^4.1.0",
    "three": "^0.78.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@parcel/config-default": "^2.16.4",
    "@parcel/transformer-pug": "2.16.4",
    "@parcel/transformer-sass": "2.16.4",
    "eslint": "^8.57.0",
    "eslint-plugin-iblokz-style": "^0.2.0",
    "parcel": "^2.16.4",
    "parcel-reporter-static-files-copy": "^1.5.3"
  },
  "staticFiles": [
    {
      "staticPath": "src/img",
      "staticOutPath": "img"
    }
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
